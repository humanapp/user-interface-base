        "target": "ES5",
        "ignoreDeprecations": "6.0",
        "noImplicitAny": true,
        "strictNullChecks": false,
        "outDir": "built",
        "rootDir": "."
    },
    "include": [
        "**/*.ts"
    ],
    "exclude": [
        "built/**",
        "pxt_modules/**/*test.ts"
    ]
}
